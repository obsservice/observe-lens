OBSERVELENS_AGENT_SERVICE_BASE_URL=http://localhost:3081
OBSERVELENS_AGENT_SERVICE_TIMEOUT_SECONDS=30
OBSERVELENS_AGENT_CORS_ALLOWED_ORIGINS=http://localhost:3080,http://127.0.0.1:3080
OBSERVELENS_AGENT_ENVIRONMENT=development
OBSERVELENS_AGENT_LOG_LEVEL=INFO
# Optional OpenAI-compatible fallback for requests unmatched by commands and regex rules.
OBSERVELENS_AGENT_INTENT_LLM_BASE_URL=https://your-llm-endpoint.example/v1
OBSERVELENS_AGENT_INTENT_LLM_API_KEY=
OBSERVELENS_AGENT_INTENT_LLM_MODEL=
OBSERVELENS_AGENT_INTENT_LLM_TIMEOUT_SECONDS=10
