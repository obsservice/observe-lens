# ObserveLens Knowledge Base service configuration.
# Copy this file to .env for local development.

OBS_KNOWLEDGE_BASE_APP_NAME="ObserveLens Knowledge Base"
OBS_KNOWLEDGE_BASE_ENVIRONMENT=local

# PostgreSQL database used by SQLAlchemy async engine and Alembic.
OBS_KNOWLEDGE_BASE_DATABASE_URL=postgresql+asyncpg://observelens:observelens@localhost:5432/observelens_knowledge

# Comma-separated origins, or * for local development.
OBS_KNOWLEDGE_BASE_CORS_ORIGINS=*

# Local object-storage directory for uploaded source files in MVP mode.
OBS_KNOWLEDGE_BASE_STORAGE_PATH=.data/knowledge-files
OBS_KNOWLEDGE_BASE_MAX_FILE_SIZE_MB=100

# Parser and embedding metadata stored on document versions.
OBS_KNOWLEDGE_BASE_PARSER_VERSION=mvp-text-parser-v1
OBS_KNOWLEDGE_BASE_EMBEDDING_MODEL=local-keyword-embedding
